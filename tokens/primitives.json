		"fast": { "$type": "duration", "$value": "140ms", "$description": "Fast transition duration." },
		"standard": {
			"$type": "duration",
			"$value": "200ms",
			"$description": "Standard transition duration."
		},
		"productive": {
			"$type": "duration",
