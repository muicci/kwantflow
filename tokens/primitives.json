{
	"$description": "Primitive design tokens that back Kwantflow's owned desktop design system.",
	"font": {
		"sans": {
			"$type": "fontFamily",
			"$value": [
				"Inter",
				"ui-sans-serif",
				"system-ui",
				"sans-serif",
				"Apple Color Emoji",
				"Segoe UI Emoji",
				"Segoe UI Symbol",
				"Noto Color Emoji"
			],
			"$description": "Default application UI font stack."
		},
		"display": {
			"$type": "fontFamily",
			"$value": [
				"SF Pro Display",
				"Avenir Next",
				"Segoe UI Variable Display",
				"Inter",
				"ui-sans-serif",
				"system-ui",
				"sans-serif",
				"Apple Color Emoji",
				"Segoe UI Emoji",
				"Segoe UI Symbol",
				"Noto Color Emoji"
			],
			"$description": "Display-oriented desktop title stack."
		}
	},
	"color": {
		"neutral": {
			"50": { "$type": "color", "$value": "#f6f8fb", "$description": "Lightest neutral surface." },
			"100": { "$type": "color", "$value": "#eef2f7", "$description": "Soft neutral surface." },
			"200": {
				"$type": "color",
				"$value": "#dde4ee",
				"$description": "Muted neutral border/surface."
			},
			"300": { "$type": "color", "$value": "#bdcad9", "$description": "Quiet neutral border." },
			"400": { "$type": "color", "$value": "#97a8bc", "$description": "Quiet neutral metadata." },
			"500": { "$type": "color", "$value": "#708197", "$description": "Muted neutral text." },
			"600": { "$type": "color", "$value": "#56657a", "$description": "Secondary neutral text." },
			"700": { "$type": "color", "$value": "#3d495a", "$description": "Strong neutral text." },
			"800": { "$type": "color", "$value": "#262f3c", "$description": "Dark shell neutral." },
			"900": { "$type": "color", "$value": "#161c24", "$description": "Primary dark text." },
			"950": { "$type": "color", "$value": "#000000", "$description": "Deepest neutral." }
		},
		"darkSurface": {
			"background": {
				"$type": "color",
				"$value": "#212121",
				"$description": "Softer dark-mode application background."
			},
			"shell": {
				"$type": "color",
				"$value": "#242424",
				"$description": "Softer dark-mode shell surface."
			},
			"panel": {
				"$type": "color",
				"$value": "#262626",
				"$description": "Softer dark-mode field and lower panel surface."
			},
			"secondary": {
				"$type": "color",
				"$value": "#2a2a2a",
				"$description": "Softer dark-mode secondary surface."
			},
			"muted": {
				"$type": "color",
				"$value": "#2b2b2b",
				"$description": "Softer dark-mode muted surface."
			},
			"selected": {
				"$type": "color",
				"$value": "#2f2f2f",
				"$description": "Softer dark-mode selected surface."
			},
			"strong": {
				"$type": "color",
				"$value": "#303030",
				"$description": "Softer dark-mode raised card surface."
			},
			"hover": {
				"$type": "color",
				"$value": "#343434",
				"$description": "Softer dark-mode hover surface."
			}
		},
		"darkText": {
			"muted": {
				"$type": "color",
				"$value": "#afafaf",
				"$description": "Softer dark-mode secondary text."
			}
		},
		"blue": {
			"50": { "$type": "color", "$value": "#f0f7ff", "$description": "Lightest accent blue." },
			"100": { "$type": "color", "$value": "#deefff", "$description": "Soft accent blue." },
			"200": { "$type": "color", "$value": "#b8ddff", "$description": "Muted accent blue." },
			"300": { "$type": "color", "$value": "#83c4ff", "$description": "Soft interactive blue." },
			"400": { "$type": "color", "$value": "#46acff", "$description": "Bright interactive blue." },
			"500": {
				"$type": "color",
				"$value": "#007aff",
				"$description": "Primary brand/action blue."
			},
			"600": { "$type": "color", "$value": "#0077e6", "$description": "Pressed brand blue." },
			"700": { "$type": "color", "$value": "#005dc0", "$description": "Strong blue contrast." },
			"800": { "$type": "color", "$value": "#0a468e", "$description": "Dark blue emphasis." },
			"900": { "$type": "color", "$value": "#11335f", "$description": "Deep blue contrast." },
			"950": { "$type": "color", "$value": "#091c35", "$description": "Darkest blue." }
		},
		"error": {
			"50": {
				"$type": "color",
				"$value": "#fff0f4",
				"$description": "Lightest destructive surface."
			},
			"100": { "$type": "color", "$value": "#ffd9e4", "$description": "Soft destructive surface." },
			"200": {
				"$type": "color",
				"$value": "#ffb0c6",
				"$description": "Muted destructive surface."
			},
			"300": {
				"$type": "color",
				"$value": "#ff7b9e",
				"$description": "Soft destructive emphasis."
			},
			"400": {
				"$type": "color",
				"$value": "#ff4f7d",
				"$description": "Bright destructive accent."
			},
			"500": {
				"$type": "color",
				"$value": "#ff2b60",
				"$description": "Default destructive accent."
			},
			"600": {
				"$type": "color",
				"$value": "#ea144e",
				"$description": "Pressed destructive accent."
			},
			"700": { "$type": "color", "$value": "#bf0f40", "$description": "Strong destructive text." },
			"800": { "$type": "color", "$value": "#981039", "$description": "Dark destructive text." },
			"900": { "$type": "color", "$value": "#7f1235", "$description": "Deep destructive text." },
			"950": { "$type": "color", "$value": "#4c071c", "$description": "Darkest destructive tone." }
		},
		"success": {
			"50": { "$type": "color", "$value": "#ebfff8", "$description": "Lightest success surface." },
			"100": { "$type": "color", "$value": "#cffff0", "$description": "Soft success surface." },
			"200": { "$type": "color", "$value": "#9afee0", "$description": "Muted success surface." },
			"300": { "$type": "color", "$value": "#59f5c6", "$description": "Soft success emphasis." },
			"400": { "$type": "color", "$value": "#24e3ad", "$description": "Bright success accent." },
			"500": { "$type": "color", "$value": "#00c78f", "$description": "Default success accent." },
			"600": { "$type": "color", "$value": "#00a574", "$description": "Pressed success accent." },
			"700": { "$type": "color", "$value": "#00835d", "$description": "Strong success text." },
			"800": { "$type": "color", "$value": "#05684b", "$description": "Dark success text." },
			"900": { "$type": "color", "$value": "#0b553f", "$description": "Deep success text." },
			"950": { "$type": "color", "$value": "#032f23", "$description": "Darkest success tone." }
		},
		"warning": {
			"50": { "$type": "color", "$value": "#fff8eb", "$description": "Lightest warning surface." },
			"100": { "$type": "color", "$value": "#ffefc8", "$description": "Soft warning surface." },
			"200": { "$type": "color", "$value": "#ffdd8a", "$description": "Muted warning surface." },
			"300": { "$type": "color", "$value": "#ffc54c", "$description": "Soft warning emphasis." },
			"400": { "$type": "color", "$value": "#ffb020", "$description": "Bright warning accent." },
			"500": { "$type": "color", "$value": "#ff9700", "$description": "Default warning accent." },
			"600": { "$type": "color", "$value": "#ea7b00", "$description": "Pressed warning accent." },
			"700": { "$type": "color", "$value": "#c25d00", "$description": "Strong warning text." },
			"800": { "$type": "color", "$value": "#9a4708", "$description": "Dark warning text." },
			"900": { "$type": "color", "$value": "#7c3a0d", "$description": "Deep warning text." },
			"950": { "$type": "color", "$value": "#472003", "$description": "Darkest warning tone." }
		}
