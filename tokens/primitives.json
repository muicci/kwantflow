		},
		"content": {
			"widthSm": {
				"$type": "dimension",
				"$value": "16rem",
				"$description": "Compact content width."
			}
		},
		"scrollPanel": {
			"default": {
				"$type": "dimension",
				"$value": "22rem",
				"$description": "Default scroll panel max height."
			},
			"sm": {
				"$type": "dimension",
				"$value": "12.5rem",
