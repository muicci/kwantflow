			"noteSm": {
				"$type": "dimension",
				"$value": "5.5rem",
				"$description": "Small note field min height."
			},
			"noteMd": {
				"$type": "dimension",
				"$value": "6rem",
				"$description": "Medium note field min height."
			},
			"noteLg": {
				"$type": "dimension",
				"$value": "7.5rem",
				"$description": "Large note field min height."
			},
			"noteXl": {
				"$type": "dimension",
				"$value": "11.25rem",
				"$description": "Extra-large note field min height."
			},
			"readonlySm": {
				"$type": "dimension",
				"$value": "3.75rem",
