	"space": {
		"1": { "$type": "dimension", "$value": "0.25rem", "$description": "4px grid step." },
		"1.5": { "$type": "dimension", "$value": "0.375rem", "$description": "6px grid step." },
		"2": { "$type": "dimension", "$value": "0.5rem", "$description": "8px grid step." },
		"3": { "$type": "dimension", "$value": "0.75rem", "$description": "12px grid step." },
		"4": { "$type": "dimension", "$value": "1rem", "$description": "16px grid step." },
		"5": { "$type": "dimension", "$value": "1.25rem", "$description": "20px grid step." },
		"6": { "$type": "dimension", "$value": "1.5rem", "$description": "24px grid step." },
		"8": { "$type": "dimension", "$value": "2rem", "$description": "32px grid step." },
		"10": { "$type": "dimension", "$value": "2.5rem", "$description": "40px grid step." },
		"12": { "$type": "dimension", "$value": "3rem", "$description": "48px grid step." },
		"16": { "$type": "dimension", "$value": "4rem", "$description": "64px grid step." }
	},
	"radius": {
		"xs": { "$type": "dimension", "$value": "0.1875rem", "$description": "Tight micro radius." },
		"tight": {
			"$type": "dimension",
			"$value": "0.375rem",
			"$description": "Dense menu and utility radius."
		},
		"base": {
			"$type": "dimension",
			"$value": "0.75rem",
			"$description": "Soft floating-shell radius."
		},
		"md": {
			"$type": "dimension",
			"$value": "calc({radius.base} - 2px)",
			"$description": "Standard surface radius."
		},
		"sm": {
			"$type": "dimension",
			"$value": "calc({radius.base} - 4px)",
			"$description": "Standard control radius."
		},
		"lg": {
			"$type": "dimension",
			"$value": "{radius.base}",
			"$description": "Floating shell radius."
		},
		"pill": {
			"$type": "dimension",
			"$value": "999px",
			"$description": "Fully rounded pill/circle radius."
		}
	},
	"size": {
		"control": {
			"xs": { "$type": "dimension", "$value": "1.5rem", "$description": "Micro control height." },
			"sm": {
				"$type": "dimension",
				"$value": "1.75rem",
				"$description": "Compact control height."
			},
			"md": { "$type": "dimension", "$value": "2rem", "$description": "Default control height." },
			"lg": { "$type": "dimension", "$value": "2.25rem", "$description": "Large control height." }
		},
		"dialog": {
			"compact": {
				"$type": "dimension",
				"$value": "26.5625rem",
				"$description": "Compact dialog width."
			},
			"xs": {
				"$type": "dimension",
				"$value": "28rem",
				"$description": "Extra-small dialog width."
			},
			"alert": {
				"$type": "dimension",
				"$value": "28.125rem",
				"$description": "Alert dialog width."
			},
			"sm": { "$type": "dimension", "$value": "30rem", "$description": "Small dialog width." },
			"md": { "$type": "dimension", "$value": "32.5rem", "$description": "Medium dialog width." },
			"lg": { "$type": "dimension", "$value": "35rem", "$description": "Large dialog width." },
			"xl": {
				"$type": "dimension",
				"$value": "43.75rem",
				"$description": "Extra-large dialog width."
			},
			"2xl": { "$type": "dimension", "$value": "47.5rem", "$description": "2xl dialog width." },
			"3xl": { "$type": "dimension", "$value": "48rem", "$description": "3xl dialog width." },
			"4xl": { "$type": "dimension", "$value": "56rem", "$description": "4xl dialog width." },
			"setupSm": {
				"$type": "dimension",
				"$value": "48rem",
				"$description": "Setup wizard compact width."
			},
			"setupLg": {
				"$type": "dimension",
				"$value": "72rem",
				"$description": "Setup wizard wide width."
			},
			"editorHeight": {
				"$type": "dimension",
				"$value": "min(440px, 68vh)",
				"$description": "Compact editor dialog height."
			},
			"setupHeight": {
				"$type": "dimension",
				"$value": "min(90vh, 960px)",
				"$description": "Setup wizard max height."
			},
			"setupCompactHeight": {
				"$type": "dimension",
				"$value": "min(85vh, 720px)",
				"$description": "Setup wizard compact max height."
			}
		},
		"sheet": {
			"md": { "$type": "dimension", "$value": "28rem", "$description": "Standard sheet width." },
			"lg": {
				"$type": "dimension",
				"$value": "18rem",
				"$description": "Compact shell sheet width."
			}
		},
		"popover": {
			"sm": { "$type": "dimension", "$value": "18rem", "$description": "Small popover width." },
			"md": { "$type": "dimension", "$value": "22rem", "$description": "Medium popover width." },
			"lg": { "$type": "dimension", "$value": "24rem", "$description": "Large popover width." },
			"xl": {
				"$type": "dimension",
				"$value": "26rem",
				"$description": "Extra-large popover width."
			}
		},
		"menu": {
			"sm": { "$type": "dimension", "$value": "11.25rem", "$description": "Small menu width." },
			"md": { "$type": "dimension", "$value": "12.5rem", "$description": "Medium menu width." }
		},
		"rail": {
			"md": {
				"$type": "dimension",
				"$value": "13rem",
				"$description": "Workspace/context rail width."
			},
			"sidebarFloatingIconWidth": {
				"$type": "dimension",
				"$value": "calc(var(--sidebar-width-icon) + {space.4} + 2px)",
