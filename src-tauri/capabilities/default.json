{
	"$schema": "../gen/schemas/desktop-schema.json",
	"identifier": "default",
	"description": "Capability for the main window",
	"windows": ["main"],
	"permissions": [
		"core:default",
		"core:webview:allow-create-webview-window",
		"core:window:allow-close",
		"core:window:allow-destroy",
		"core:window:allow-set-focus",
		"core:window:allow-show",
		"core:window:allow-set-title",
		"core:window:allow-start-dragging",
		"core:window:allow-theme",
		"core:window:allow-unminimize",
		{
			"identifier": "opener:allow-open-url",
			"allow": [
				{
					"url": "mailto:*"
				},
				{
					"url": "tel:*"
				},
				{
					"url": "http://*"
				},
				{
					"url": "https://*"
				}
			]
		},
		"opener:deny-open-path",
		"opener:deny-reveal-item-in-dir",
		"default",
		"store:default",
		"log:default",
		"dialog:default",
		"process:allow-restart",
		"allow-query-control-database",
		"allow-execute-control-database",
		"allow-query-workspace-database",
		"allow-execute-workspace-database",
		"allow-start-local-ai-conversation",
		"allow-send-local-ai-message",
		"allow-end-local-ai-conversation",
		"allow-get-local-ai-conversation-tokens",
		"allow-rasterize-pdf-pages",
		"fs:deny-default",
		"fs:allow-exists",
		"fs:allow-stat",
		"fs:allow-read-dir",
		"fs:allow-read-file",
		"fs:allow-read-text-file",
		"fs:allow-mkdir",
		"fs:allow-copy-file",
		"fs:allow-remove",
		"fs:allow-write-file",
		"fs:allow-write-text-file",
		{
			"identifier": "fs:scope",
			"allow": [
				{ "path": "$APPLOCALDATA/account" },
				{ "path": "$APPLOCALDATA/account/**" },
				{ "path": "$APPLOCALDATA/attachments" },
				{ "path": "$APPLOCALDATA/attachments/**" },
				{ "path": "$APPLOCALDATA/intake-temp" },
				{ "path": "$APPLOCALDATA/intake-temp/**" },
				{ "path": "$APPCACHE/generated-previews" },
				{ "path": "$APPCACHE/generated-previews/**" },
				{ "path": "$APPCACHE/ai-evidence" },
				{ "path": "$APPCACHE/ai-evidence/**" }
			]
		}
	]
}
