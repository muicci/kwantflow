{
	"name": "kwantflow-app",
	"version": "0.13.0",
	"private": true,
	"packageManager": "pnpm@11.9.0",
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "11.9.0",
			"onFail": "ignore"
		}
	},
	"description": "Local-first desktop platform for RFQ management, file review, estimating, and quote preparation.",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"dev:tauri": "vite dev",
		"dev:reset:fresh-run": "node --import tsx ./scripts/dev-reset-fresh-run.ts",
		"build": "vite build",
		"preview": "vite preview",
		"db:generate-types": "tsx scripts/generate-db-types.ts",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsx scripts/generate-db-types.ts --check",
		"pretest": "svelte-kit sync",
		"test": "vitest run --project unit",
		"test:watch": "vitest --project unit",
		"design:build": "node --import tsx ./scripts/design-tokens.ts build",
		"design:verify": "node --import tsx ./scripts/design-tokens.ts verify",
		"tauri": "node --import tsx ./scripts/tauri-cli.ts",
		"tauri:check": "node --import tsx ./scripts/cargo-cli.ts check --manifest-path src-tauri/Cargo.toml",
		"local-ai:hardware": "node --import tsx ./scripts/local-ai-hardware-sample.ts",
		"lint": "prettier --check . && eslint --cache --cache-location .cache/eslint/ src scripts vite.config.js vitest.config.ts eslint.config.js svelte.config.js",
		"format": "prettier --write .",
		"clean:artifacts": "node --import tsx ./scripts/clean-artifacts.ts",
		"branding:build:macos-icon-assets": "node --import tsx ./scripts/build-macos-icon-assets.ts",
		"branding:refresh:macos": "node --import tsx ./scripts/refresh-macos-icon-cache.ts",
		"branding:regen": "node --import tsx ./scripts/regenerate-branding-assets.ts",
		"fonts:build:cad": "node --import tsx ./scripts/build-cad-open-font.ts",
		"migrations:lock": "node --import tsx ./scripts/migration-checksums.ts --write",
		"migrations:verify": "node --import tsx ./scripts/migration-checksums.ts",
		"storybook": "storybook dev -p 6006 --disable-telemetry",
		"build-storybook": "storybook build --disable-telemetry",
		"storybook:test": "vitest run --project storybook",
		"dead:code": "knip",
		"native:prepare": "node --import tsx scripts/native-prepare.ts",
		"distribution:build": "node --import tsx scripts/distribution-build.ts",
		"distribution:verify": "node --import tsx scripts/distribution-verify.ts",
		"distribution:source": "node --import tsx scripts/distribution-source.ts",
		"sources:prepare": "node --import tsx scripts/dependency-source-prepare.ts",
		"sources:verify": "node --import tsx scripts/dependency-source-prepare.ts --check",
		"third-party:sources:prepare": "node --import tsx scripts/third-party-source-prepare.ts",
		"third-party:inventory": "node --import tsx scripts/third-party-inventory.ts --strict",
		"third-party:verify": "node --import tsx scripts/verify-third-party.ts",
		"verify": "pnpm check && pnpm lint && pnpm test && pnpm migrations:verify && pnpm design:verify && pnpm tauri:check && pnpm tauri:test",
		"tauri:test": "node --import tsx ./scripts/cargo-cli.ts test --lib --manifest-path src-tauri/Cargo.toml"
	},
	"license": "GPL-3.0-only",
	"dependencies": {
		"@dnd-kit-svelte/svelte": "^0.1.6",
		"@dnd-kit/abstract": "^0.2.4",
		"@dnd-kit/helpers": "^0.1.21",
		"@internationalized/date": "^3.12.1",
		"@kenjiuno/msgreader": "1.28.0",
		"@linkiez/dxf-renew": "^7.4.5",
		"@lucide/svelte": "^0.561.0",
		"@mlightcad/cad-simple-viewer": "1.5.11",
		"@mlightcad/data-model": "1.12.5",
		"@mlightcad/libredwg-web": "0.7.9",
		"@mlightcad/mtext-renderer": "0.12.4",
		"@mlightcad/three-renderer": "1.5.11",
		"@tanstack/table-core": "^8.21.3",
		"@tauri-apps/api": "^2.11.1",
		"@tauri-apps/plugin-dialog": "^2.7.1",
		"@tauri-apps/plugin-fs": "^2.5.1",
		"@tauri-apps/plugin-log": "^2.9.0",
		"@tauri-apps/plugin-opener": "^2.5.4",
		"@tauri-apps/plugin-process": "^2.3.1",
		"@tauri-apps/plugin-store": "^2.4.3",
		"@velipso/polybool": "1.1.1",
		"bits-ui": "^2.18.1",
		"clsx": "^2.1.1",
		"comlink": "^4.4.2",
		"date-fns": "^4.1.0",
		"decimal.js": "^10.6.0",
		"eml-parse-js": "1.2.0-beta.1",
		"fuse.js": "^7.3.0",
		"html2canvas": "^1.4.1",
		"jszip": "^3.10.1",
		"kysely": "^0.29.2",
		"libheif-js": "file:packages/libheif-js",
		"libphonenumber-js": "^1.13.7",
		"lodash-es": "4.18.1",
		"mammoth": "^1.13.0",
		"mode-watcher": "^1.1.0",
		"occt-import-js": "0.0.23",
		"paneforge": "^1.0.2",
		"papaparse": "^5.5.4",
		"pdf-lib": "^1.17.1",
		"pdfjs-dist": "^6.2.108",
		"svelte-sonner": "^1.1.1",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^3.2.2",
		"three": "0.172.0",
		"tiff": "^7.1.3",
		"xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.0",
		"@eslint/js": "^10.0.1",
		"@storybook/addon-a11y": "^10.5.7",
		"@storybook/addon-docs": "^10.5.7",
		"@storybook/addon-svelte-csf": "^5.1.2",
		"@storybook/addon-vitest": "^10.6.2",
		"@storybook/sveltekit": "^10.5.7",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tailwindcss/vite": "^4.3.3",
		"@tauri-apps/cli": "^2.11.4",
		"@testing-library/svelte": "^5.4.2",
		"@types/node": "^24.12.4",
		"@types/three": "0.172.0",
		"@vitest/browser-playwright": "4.1.11",
		"better-sqlite3": "^12.11.1",
		"eslint": "^10.6.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-storybook": "^10.5.7",
		"eslint-plugin-svelte": "^3.23.0",
		"glob": "^13.0.6",
		"globals": "^17.11.0",
		"jsdom": "^28.1.0",
		"knip": "^6.41.0",
		"playwright": "^1.62.1",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^3.5.2",
		"prettier-plugin-tailwindcss": "^0.7.4",
		"storybook": "^10.5.7",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^4.3.3",
		"tsx": "^4.22.0",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.67.0",
		"vite": "^8.2.1",
		"vitest": "4.1.11",
		"yaml": "2.9.0"
	}
}
