# Kwantflow needs no environment variables to build or run.
# Everything below is optional. Copy to .env.local (ignored) only if you need an override.

# ------------------------------------------------------------
# Local AI runtime overrides
# ------------------------------------------------------------
# Directory containing a prebuilt LiteRT-LM runtime library.
# KWANTFLOW_LITERT_LM_RUNTIME_DIR=/path/to/litert-lm/runtime
# Directory containing an already downloaded, verified Local AI model.
# KWANTFLOW_LOCAL_AI_DIR=/path/to/local-ai
# Force CPU inference (diagnostics).
# KWANTFLOW_FORCE_CPU=1

# ------------------------------------------------------------
# Optional macOS signing for maintainers (`pnpm distribution:build -- --sign`)
# Unsigned/ad-hoc builds need none of these.
# ------------------------------------------------------------
# APPLE_SIGNING_IDENTITY="Developer ID Application: Your Name (TEAMID)"
# APPLE_API_KEY=your_app_store_connect_key_id
# APPLE_API_ISSUER=your_app_store_connect_issuer_uuid
# APPLE_API_KEY_PATH=/secure/path/AuthKey_XXXXXXXXXX.p8
